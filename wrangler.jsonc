{
  "name": "bbci",
  "main": "src/worker.js",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "badgerland-bbci.org/*",
      "zone_name": "badgerland-bbci.org"
    }
  ],
  "assets": {
    "directory": "./deploy-69c40b8145cfe2cd66da56bc",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "CONTACT_TO_EMAIL": "info@badgerland-BBCI.org"
  }
}
